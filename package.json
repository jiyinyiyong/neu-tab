{
  "name": "calcit-workflow",
  "version": "0.1.2",
  "description": "ClojureScript workflow using Calcit Editor",
  "main": "index.js",
  "scripts": {
    "compile": "calcit js",
    "watch": "calcit -w",
    "dev": "yarn compile && vite",
    "watch-ssr": "calcit --entry ssr --emit-path ssr-out/ -w js",
    "compile-ssr": "calcit --entry ssr --emit-path ssr-out/ js",
    "ssr": "yarn compile-ssr && node ssr.mjs",
    "get-fonts": "cd dist && wget --recursive http://cdn.tiye.me/favored-fonts/main-fonts.css -q --show-progress",
    "get-logos": "cd dist && wget --recursive wget -r http://cdn.tiye.me/logo/ --no-parent -q --show-progress",
    "get2": "yarn get-fonts && yarn get-logos",
    "cp": "cp entry/manifest.json dist && cp entry/neu.png dist",
    "build": "yarn compile && vite build",
    "crx": "VITE_BASE_URL=./ yarn build && yarn cp && zip -r neu-tab.zip dist/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jiyinyiyong/neu-tab.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "devDependencies": {
    "vite": "8.3.1"
  },
  "dependencies": {
    "@calcit/procs": "0.30.1-alpha.5",
    "dayjs": "^1.11.13"
  },
  "packageManager": "yarn@4.18.0"
}
